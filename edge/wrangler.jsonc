{
  // Zeron edge: per-session + per-workspace Loro sync DOs, per-device
  // relay DOs, R2 blobs and the absorbed WorkOS auth routes. The upstream
  // Cloud control plane and vault are compiled in but unbound here.
  // Design: loro-sessions §2 (topology), §3 (persistence), §6.1 (diff
  // sidecar), §8 (device-room streams), §1.2 (R2 attachments), §3.3 (R2
  // backups); ARCHITECTURE.md §6.
  // NOTE: Durable Object storage is bound to the script name, so renaming
  // the worker orphans every session/registry/chat room. This fork runs on
  // its own Cloudflare account with fresh storage, so the "zerun" names are
  // the originals here.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed by .github/workflows/deploy.yml on pushes to dev that touch
  // edge/ (CLOUDFLARE_API_TOKEN repo secret).
  "name": "zerun-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "808eccb28c4b8ff2386cb40c20704b22",
  "workers_dev": true,
  // Public hostname for this fork: one host serves the API, the `curl | sh`
  // installer at /install.sh, and release artifacts at /releases/*. The
  // landing page is not deployed in this fork.
  "routes": [
    { "pattern": "edge.550w.host", "custom_domain": true }
  ],
  // Serve src/install.sh as a string (the /install.sh route).
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  // loro-crdt's default entry loads its WASM via URL fetch, which workerd
  // cannot do at runtime; the base64 entry inlines the module instead.
  "alias": {
    "loro-crdt": "loro-crdt/base64"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOMS", "class_name": "SessionRoom" },
      { "name": "DEVICE_ROOMS", "class_name": "DeviceRoom" },
      { "name": "PREVIEW_ROOMS", "class_name": "PreviewRoom" },
      { "name": "REGISTRY_ROOMS", "class_name": "RegistryRoom" },
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" },
      // WorkOS user profiles, organizations and members, independent of Cloud hosting.
      { "name": "USER_DIRECTORY", "class_name": "UserDirectory" }
      // Cloud binds CLOUD_ACCOUNTS/CLOUD_INDEX here upstream; this fork keeps
      // them unbound (docs/fork-cloud.md), so /cloud answers available: false.
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom", "DeviceRoom"]
    },
    {
      // Workspace registry (docs/registry-sync.md) — the row-table sidebar
      // sync that replaces the Loro workspace doc rooms.
      "tag": "v2",
      "new_sqlite_classes": ["RegistryRoom"]
    },
    {
      // chat2 session rooms (docs/chat2-sync.md) — dumb log relays that
      // replace SessionRoom's loro-aware s2 rooms.
      "tag": "v3",
      "new_sqlite_classes": ["ChatRoom"]
    },
    { "tag": "v4", "new_sqlite_classes": ["PreviewRoom"] },
    // Upstream v5 adds the Cloud classes, which stay unbound in this fork.
    { "tag": "v6", "new_sqlite_classes": ["UserDirectory"] }
  ],
  // No `workflows`, `services` (vault) or `triggers` (Cloud billing cron) in
  // this fork; docs/fork-cloud.md records what a deployment would need.
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "zerun-blobs"
    },
    {
      // Release artifacts for /releases/* (curl-install + dmg downloads).
      "binding": "RELEASES",
      "bucket_name": "zerun-releases"
    }
  ],
  "vars": {
    // WorkOS AuthKit client id — JWTs verified against its JWKS. Keep in
    // sync with crates/client/src/auth.rs and the iOS sign-in view.
    // Set AUTH_MODE=dev locally to accept bearer==userId. WORKOS_API_KEY is
    // a wrangler secret (`wrangler secret put WORKOS_API_KEY`) powering the
    // /auth/* routes. Session push notifications (registry-room.ts) need two
    // more secrets: `wrangler secret put APNS_KEY_P8` (the AuthKey_XXXX.p8
    // file's contents) and `wrangler secret put APNS_KEY_ID`. Unset ⇒ decided
    // and logged on /registry/:org/stats, not sent.
    // WorkOS user directory: configure https://edge.550w.host/workos/webhook
    // for created/updated/deleted events of user, organization and
    // organization_membership. Set WORKOS_WEBHOOK_SECRET to the endpoint
    // signing secret. Unset => webhooks answer 503 for retries.
    // ADMIN_TOKEN protects GET /admin/users and /admin/organizations
    // (JSON or ?format=csv); unset => 404.
    "WORKOS_CLIENT_ID": "client_01M4AN0G973H42GQJY8RAAC0RS",
    "AUTH_MODE": "workos"
    // Cloud and the credential vault stay unconfigured in this fork: no
    // CLOUD_* Durable Objects, Workflows, VAULT service binding or cron is
    // bound, so /cloud answers `available: false` and a deploy creates no
    // Cloud infrastructure (docs/fork-cloud.md).
  },
  "observability": {
    "enabled": true
  }
}

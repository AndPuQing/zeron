local function start_import(): any
	local app = mount("shell_fixture.luau")
	app:resize(1200, 900)
	app:frames(30)
	app:command("shell.palette")
	app:frames(20)
	app:type('role:textbox "Search"', "Import sessions")
	app:frames(20)
	app:click('#palette-list >> role:option "Import sessions"')
	app:frames(30)
	expect(app:has('"MacBook Pro"')).to_be(true)
	app:click('role:checkbox "Saved session"')
	app:frames(10)
	app:click('role:button "Import"')
	app:frames(10)
	expect(app:tree('role:dialog "Import sessions"')).to_contain("Importing")
	return app
end

test("external session import opens the imported chat from the palette", function()
	local app = start_import()
	app:command("fixture.finish_import")
	app:frames(20)
	app:click('role:button "Open chat"')
	app:frames(20)
	expect(app:state("fixture_open_chat")).to_be("a1")
end)

test("external session import closes its running picker", function()
	local app = start_import()
	app:click('role:dialog "Import sessions" >> role:button "Close"')
	app:frames(20)
	expect(app:state("fixture_import_cancelled")).to_be(true)
end)

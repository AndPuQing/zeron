[
  {
    "name": "bash",
    "input": {
      "command": "git status --short",
      "description": "Inspect changes"
    },
    "expected": {
      "kind": "exec",
      "command": "git status --short"
    }
  },
  {
    "name": "read",
    "input": {
      "file_path": "src/main.rs",
      "offset": 2
    },
    "expected": {
      "kind": "readFile",
      "path": "src/main.rs"
    }
  },
  {
    "name": "write",
    "input": {
      "file_path": "notes.md",
      "content": "fixture-secret-body"
    },
    "expected": {
      "kind": "writeFile",
      "path": "notes.md",
      "content": "fixture-secret-body"
    }
  },
  {
    "name": "edit",
    "input": {
      "file_path": "src/main.rs",
      "old_string": "fixture-secret-old",
      "new_string": "fixture-secret-new"
    },
    "expected": {
      "kind": "editFile",
      "path": "src/main.rs",
      "old_string": "fixture-secret-old",
      "new_string": "fixture-secret-new"
    }
  },
  {
    "name": "str_replace_editor",
    "input": {
      "command": "view",

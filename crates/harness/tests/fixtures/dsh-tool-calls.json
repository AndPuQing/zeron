    }
  },
  {
    "name": "web_fetch",
    "input": {
      "url": "https://example.com/docs"
    },
    "expected": {
      "kind": "webFetch",
      "url": "https://example.com/docs"
    }
  },
  {
    "name": "web_search",
    "input": {

      "old_str": "fixture-secret-old",
      "new_str": "fixture-secret-new"
    },
    "expected": {
      "kind": "readFile",
      "path": "src/lib.rs"
    }
  },
  {
    "name": "str_replace_editor",
    "input": {
      "command": "create",
      "path": "src/lib.rs",
      "file_text": "fixture-secret-body",
      "old_str": "fixture-secret-old",
      "new_str": "fixture-secret-new"
    },
    "expected": {
      "kind": "writeFile",
      "path": "src/lib.rs",
      "content": "fixture-secret-body"
    }
  },
  {
    "name": "str_replace_editor",
    "input": {
      "command": "str_replace",
      "path": "src/lib.rs",
      "file_text": "fixture-secret-body",
      "old_str": "fixture-secret-old",
      "new_str": "fixture-secret-new"
    },
    "expected": {
      "kind": "editFile",
      "path": "src/lib.rs",
      "old_string": "fixture-secret-old",
      "new_string": "fixture-secret-new"
    }
  },
  {
    "name": "str_replace_editor",
    "input": {
      "command": "insert",
      "path": "src/lib.rs",
      "file_text": "fixture-secret-body",
      "old_str": "fixture-secret-old",
      "new_str": "fixture-secret-new"
    },
    "expected": {
      "kind": "editFile",
      "path": "src/lib.rs",
      "old_string": "fixture-secret-old",
      "new_string": "fixture-secret-new"
    }
  },
  {
    "name": "grep",
    "input": {
      "pattern": "TODO",
      "path": "src"
    },
    "expected": {
      "kind": "search",
      "pattern": "TODO",
      "path": "src"
    }
  },
  {
    "name": "glob",
    "input": {
      "pattern": "**/*.rs",
